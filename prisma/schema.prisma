generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pengaduan {
  id           Int      @id @default(autoincrement())
  nama         String?
  email        String?
  jenisKelamin String?
  noTelepon    String?
  kronologi    String
  createdAt    DateTime @default(now())
}
